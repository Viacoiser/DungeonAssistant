{
  "functions": {
    "backend/api/index.py": {
      "maxDuration": 60
    }
  },
  "routes": [
    {
      "src": "/api(.*)",
      "dest": "backend/api/index.py"
    },
    {
      "src": "/(.*)",
      "dest": "frontend/dist/index.html"
    }
  ],
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "frontend/dist" }
    }
  ]
}
