{
  "version": 2,
  "functions": {
    "backend/api/index.py": {
      "maxDuration": 60
    }
  },
  "routes": [
    {
      "src": "/socket.io(.*)",
      "dest": "backend/api/index.py"
    },
    {
      "src": "/api(.*)",
      "dest": "backend/api/index.py"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/dist/index.html"
    }
  ]
}
